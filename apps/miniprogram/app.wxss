.page{min-height:100vh;background:linear-gradient(135deg,#f7fbff,#eaf4ff);padding:24rpx;color:#14213d}.card{background:rgba(255,255,255,.86);border:1rpx solid #dce8fb;border-radius:28rpx;padding:24rpx;margin-bottom:22rpx;box-shadow:0 12rpx 40rpx rgba(80,116,170,.12)}.title{font-size:38rpx;font-weight:800}.sub{color:#6980aa}.chip{display:inline-block;background:#eef6ff;color:#1e68d9;border-radius:18rpx;padding:8rpx 16rpx;margin:8rpx}.red{color:#f0392d}.disclaimer{font-size:22rpx;color:#6d7f9d;line-height:1.6;margin:30rpx 0}.row{display:flex;justify-content:space-between;border-bottom:1rpx solid #e6effb;padding:14rpx 0}.search{background:#fff;border-radius:36rpx;padding:18rpx 24rpx;color:#7c8fb4;margin:20rpx 0}